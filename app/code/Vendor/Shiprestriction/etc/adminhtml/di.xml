<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Amasty\Shiprestriction\Controller\Adminhtml\Rule\Delete">
        <arguments>
            <argument name="ruleModel" xsi:type="object" shared="false">Amasty\Shiprestriction\Model\Rule</argument>
            <argument name="resource" xsi:type="object">Amasty\Shiprestriction\Model\ResourceModel\Rule</argument>
        </arguments>
    </type>

    <type name="Amasty\Shiprestriction\Controller\Adminhtml\Rule\Duplicate">
