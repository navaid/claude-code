            <argument name="ruleModel" xsi:type="object" shared="false">Amasty\Shiprestriction\Model\Rule</argument>
            <argument name="resource" xsi:type="object">Amasty\Shiprestriction\Model\ResourceModel\Rule</argument>
        </arguments>
    </type>

    <type name="Amasty\Shiprestriction\Controller\Adminhtml\Rule\MassAction">
