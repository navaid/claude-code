            <argument name="collection" xsi:type="object" shared="false">Amasty\Shiprestriction\Model\ResourceModel\Rule\Collection</argument>
            <argument name="resource" xsi:type="object">Amasty\Shiprestriction\Model\ResourceModel\Rule</argument>
        </arguments>
